# Copy to `.env` and fill in. Never commit the result.
#
#   cp .env.example .env
#
# `.env` holds the database password and the session signing key. Both are
# secrets, which is why this file is a template and `.env` is git-ignored.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# console for local development, json for anything a machine reads.
LOG_FORMAT=console

# Where a staff member is sent to sign in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the browser reaches the API. Baked into the frontend at build time, so it
# must be a URL the *browser* can resolve - not a container hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Browser origins allowed to call the API with credentials. JSON, not a
# comma-separated list. Must be set in production or the admin UI cannot sign in.
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql+asyncpg://humera:humera@localhost:5432/humera
DATABASE_SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# ---------------------------------------------------------------------------
# Sessions and passwords
# ---------------------------------------------------------------------------

# REQUIRED in production. Signs staff session cookies; rotating it logs
# everybody out. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Lifetime of a staff session, and how long it survives being unused before its
# last-used stamp is rewritten.
SESSION_EXPIRE_MINUTES=10080
SESSION_LAST_USED_REFRESH_SECONDS=300

# Name of the session cookie. The frontend does not need to know this - it lets
# the browser attach the cookie - but changing it signs everybody out.
SESSION_COOKIE_NAME=humera_staff_session

# Argon2id cost. The defaults are a deliberate balance: strong enough that a
# stolen hash is expensive to attack, cheap enough that signing in stays
# responsive on modest hardware. Raising the cost slows login and logout.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# NOTE: ACCESS_TOKEN_EXPIRE_MINUTES and REFRESH_TOKEN_EXPIRE_DAYS exist in the
# settings object but nothing reads them. Sessions are opaque stored tokens with
# the lifetime above, not JWTs. They are left out of this file on purpose - see
# the docstring on `create_token` in app/core/security.py.

# ---------------------------------------------------------------------------
# Vehicle photographs
# ---------------------------------------------------------------------------

# Only "local" is implemented. A single switch rather than a plug-in interface,
# because there is exactly one backend to configure.
IMAGE_STORAGE_BACKEND=local

# Where the files live. Must be a mounted, persistent volume in production - a
# container filesystem is discarded on every deploy, taking the photographs with
# it while the database rows survive and point at nothing.
IMAGE_STORAGE_ROOT=./media

# URL prefix the files are served from. `app.main` mounts IMAGE_STORAGE_ROOT
# here, and stored URLs are built from it, so changing it rewrites every stored
# image URL.
IMAGE_MEDIA_PREFIX=/media

# Absolute base for stored image URLs. Leave empty to serve them from this API.
# Set it when photographs are served from a CDN or a separate media host, so the
# URLs written to the database are the ones visitors actually fetch.
IMAGE_PUBLIC_BASE_URL=

# Upload limits. The byte ceiling is checked before decoding, and the pixel
# dimensions after, so a decompression bomb is bounded in both directions.
IMAGE_MAX_BYTES=10485760
IMAGE_MIN_WIDTH=320
IMAGE_MIN_HEIGHT=240
IMAGE_MAX_WIDTH=12000
IMAGE_MAX_HEIGHT=12000

# Per request and per vehicle. The per-vehicle cap is enforced against the
# database, so it holds however many requests arrive at once.
IMAGE_MAX_FILES_PER_REQUEST=10
IMAGE_MAX_PER_VEHICLE=30
