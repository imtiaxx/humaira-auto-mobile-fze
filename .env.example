# ---------------------------------------------------------------------------
# Humera Automobile - Environment Configuration Template
#
# Copy this file to `.env` and replace every placeholder with a real value.
# NEVER commit a real `.env` file to version control.
#
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="Humera Automobile API"
APP_ENV=development              # development | staging | production
APP_VERSION=0.1.0
DEBUG=true

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (SQLAlchemy asyncpg / psycopg format).
# Local example:
#   postgresql+psycopg://humera:CHANGE_ME@localhost:5432/humera_automobile
DATABASE_URL=
# Set to false to skip the startup database connectivity check.
DATABASE_SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Security / Secrets ---------------------------------------------------
# Used to sign sessions and future access/refresh tokens. MUST be replaced.
SECRET_KEY=
# Minutes. Sliding expiry applied to the session cookie.
SESSION_EXPIRE_MINUTES=10080       # 7 days
# Minutes. Lifetime of future access tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Days. Lifetime of future refresh tokens.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Argon2 password hashing parameters (tuned on real hardware before launch).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536          # KiB (64 MB)
ARGON2_PARALLELISM=4

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000

# --- API ------------------------------------------------------------------
# Prefix mounted by the FastAPI application.
API_V1_PREFIX=/api/v1
# Comma-separated origins allowed to trigger the interactive /docs schema.
DOCS_ENABLED=true

# --- Logging --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=console                # console | json

# --- Frontend (Next.js public variables) ----------------------------------
# Base URL of the backend API as reachable from the browser and the server.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public site origin, used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
