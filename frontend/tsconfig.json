{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    /**
     * Permits `import ... from "./thing.ts"`.
     *
     * Required by the unit tests, which run on Node's built-in test runner
     * (`node --test`) using native TypeScript type stripping. Node resolves
     * extensionless specifiers for JavaScript but not for stripped TypeScript, so
     * the test files must name the real extension.
     *
     * Valid here because `noEmit` is set - the flag is rejected by `tsc` in any
     * configuration that actually writes JavaScript, and this project does not.
     * Application code still uses extensionless imports; only the test files
     * carry the extension.
     */
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
