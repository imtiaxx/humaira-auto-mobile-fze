# ---------------------------------------------------------------------------
# Humera Automobile - frontend environment template.
#
# Copy to `.env.local` and adjust. `.env.local` is git-ignored.
#
# Next.js only loads `.env*` files from the `frontend/` directory (the
# Next.js project root), not from the repository root.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Used for Server Components, Route Handlers and
# any browser-side request. Must be reachable from the machine running Next.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this site. Used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Official WhatsApp number for customer enquiries.
#
# OPTIONAL. Leave this unset until the business confirms the number. Every
# WhatsApp call to action is suppressed while it is missing - the site never
# renders a link to an unverified number, and never invents a placeholder.
#
# Accepted formats: +971501234567, 0501234567, +971 (50) 123-4567
# Rules: 7-15 digits, digits/spaces/brackets/dots/hyphens only.
# Add the country code. A local-format number will not resolve for an
# international visitor dialling from abroad.
NEXT_PUBLIC_WHATSAPP_NUMBER=
